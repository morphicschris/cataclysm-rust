# Large third-party tooling and generated state
/tools/ghidra_12.1.4_PUBLIC/
/tools/dl/
/tools/ghidra-mcp/
/reference/
/ghidra/*.rep/
/ghidra/*.gpr
/ghidra/*.lock*
/ghidra/*.log

# Never commit original game data or binaries
*.big
*.bik
*.vce
*.wxd
*.exe
*.dll

/target/

# Private research artifacts (publishing decision: Rust only)
/recovered/
/ghidra/

# Extracted original game data (never commit)
/extracted/

# Renders of original game assets (never commit)
/screenshots/
__pycache__/
/builds/

# Exported music from the player's install (never commit)
/music/
/docs/ui-mockups/

# Stray screenshot output when HWC_SCREENSHOTS=1 is relative
/crates/*/1/
*.png
!crates/**/tests/data/**/*.png
